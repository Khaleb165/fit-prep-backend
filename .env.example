# Local Postgres connection used by the Dart Frog backend.
# Update username, password, host, port, and database name for your machine.
DATABASE_URL=postgresql://postgres:postgres@path-to-your-database:port/your-database-name?sslmode=disable

# Set to true if you want the API server to run database/schema.sql on startup.
# You can leave this false and run `dart run bin/migrate.dart` manually instead.
DATABASE_AUTO_MIGRATE=false
